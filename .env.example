# Never place secrets in NEXT_PUBLIC_* variables.
# `npm run db:dev` writes ignored .local/dev-pg/app.env with private socket URLs.
# Copy no real production secrets into this VM. Examples intentionally have no credentials.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Separate least-privilege local operations credentials; never loaded by Next.
OPERATOR_DATABASE_URL=
ERASURE_DATABASE_URL=
BACKUP_DATABASE_URL=
RESTORE_DATABASE_URL=
# Independent 32-byte hex AES key; never commit/share or store with backup media.
INQUIRY_BACKUP_KEY=
INQUIRIES_ENABLED=false
INQUIRY_ORIGIN=http://127.0.0.1:3000
# Independent random secret, at least 32 characters; rotate only after replay expiry.
INQUIRY_DIGEST_SECRET=
# Explicit private loopback-only development mode. Never use behind a public listener.
INQUIRY_NETWORK_MODE=loopback
# Deployment mode: signed-proxy. Independent >=32-character secret shared only
# with the trusted ingress; see docs/P2-B1.md. Never accept unsigned forwarding headers.
INQUIRY_PROXY_SECRET=
# Integration runner creates its own disposable cluster, never uses DATABASE_URL.
